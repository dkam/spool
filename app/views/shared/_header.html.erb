<%#
  The header bar. 58px tall, one rule beneath it, nothing else — the design
  carries structure with alignment and dividers rather than surfaces.

  The design's nav switched between the three canvas screens. Here Ticket and
  Customer are drill-downs you reach by clicking a row, so the nav carries only
  the destinations you can actually navigate to.

  Signed out, that is none of them: the login screen renders this header too,
  and a Tickets link there bounces straight back to login. So the nav appears
  only when there is somebody here to use it. What stays is what still means
  something locked out — the wordmark, which instance this is, and the theme.

  The condition is `current_agent`, not `authenticated?`. Open mode has no
  session and every request is the stand-in agent, so `authenticated?` is false
  on a perfectly usable app; `current_agent` is the one that means "there is
  somebody here" in both modes.
%>
<header class="flex items-center gap-10 px-14 h-[58px] border-b border-rule">
  <%= link_to root_path, class: "flex items-baseline gap-[7px] font-semibold tracking-[-0.01em] hover:no-underline" do %>
    Spool
    <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
  <% end %>

  <% if current_agent %>
    <%# Also the keyboard's way home: T visits this link's href, so the key is
        available on exactly the screens this nav is — every one of them — and
        the controller never learns a route. %>
    <nav class="flex gap-[22px] text-mid">
      <%= link_to "Tickets", root_path,
            data: { shortcuts_target: "tickets" },
            class: "hover:no-underline #{chip_class(controller_name == "tickets")}" %>
    </nav>
  <% end %>

  <div class="ml-auto flex items-center gap-4 text-sm" data-controller="theme">
    <%# Only when mail has stopped moving — see MailHealth. Signed-in only, like
        the nav: the login screen has nobody to tell. %>
    <% if current_agent && (problems = MailHealth.new.problems).any? %>
      <ul data-mail-health role="status" class="flex items-center gap-4 text-accent">
        <% problems.each do |problem| %>
          <li title="<%= problem.hint %>" class="flex items-center gap-2 cursor-help">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span><%= problem.summary %>
          </li>
        <% end %>
      </ul>
      <span class="w-px h-3.5 bg-rule"></span>
    <% end %>

    <span class="font-mono text-faint"><%= mailbox_address %></span>
    <span class="w-px h-3.5 bg-rule"></span>

    <%# Theme is a client-side preference the server never sees, so these two
        style themselves on connect — from the system's setting, or from
        localStorage while a choice made here differs from it. %>
    <button type="button"
            data-theme-target="option"
            data-theme-value-param="light"
            data-action="theme#choose"
            class="cursor-pointer text-soft hover:text-ink">Light</button>
    <button type="button"
            data-theme-target="option"
            data-theme-value-param="dark"
            data-action="theme#choose"
            class="cursor-pointer text-soft hover:text-ink">Dark</button>

    <%# Settings belongs to whoever is here, so current_agent, like the nav —
        open mode has a stand-in agent with settings of its own. %>
    <% if current_agent %>
      <span class="w-px h-3.5 bg-rule"></span>
      <%= link_to "Settings", settings_path,
            class: "hover:no-underline #{chip_class(controller_name == "settings")}" %>
    <% end %>

    <% if authenticated? %>
      <span class="w-px h-3.5 bg-rule"></span>
      <%= button_to "Sign out", logout_path, method: :delete,
            class: "cursor-pointer text-soft hover:text-ink hover:underline" %>
    <% end %>
  </div>
</header>
