<% content_for :title, "Tickets · Spool" %>

<% content_for :shortcuts do %>
  <span class="flex items-center gap-2"><kbd>J</kbd><kbd>K</kbd> Move</span>
  <span class="flex items-center gap-2"><kbd>L</kbd> Open</span>
  <span class="flex items-center gap-2"><kbd>T</kbd> Tickets</span>
  <span class="flex items-center gap-2"><kbd>/</kbd> Search</span>
<% end %>

<%# Any ticket commit refreshes this page (Ticket broadcasts to :tickets), so
    new mail and other agents' changes appear without reloading. The re-fetch
    runs through the controller as usual — filters, search and the 200-row cap
    all still apply. %>
<%= turbo_stream_from :tickets %>

<div class="max-w-[1000px] px-14 pt-12 pb-24">
  <div class="flex items-baseline gap-4">
    <h1 class="text-title font-bold tracking-[-0.02em]">Tickets</h1>
    <%# "open" is a state, not a countable noun — pluralize would say "3 opens". %>
    <span class="text-sm text-soft">
      <%= @open_count %> open, <%= @unread_count %> unread
    </span>
  </div>

  <%# Search narrows this list in place, so it lives here rather than in the
      header: the moment "/" is pressed only means something on a screen that
      has a list to narrow, and results always land here — search is a `?q=`
      narrowing of this list, not a screen of its own. Submitting into the
      ticket_list frame below is what makes search-as-you-type possible: the
      frame swaps and the caret stays put. See search_controller.js. %>
  <%= form_with url: tickets_path, method: :get, class: "flex items-baseline gap-5 mt-6 pb-3 border-b border-rule",
        data: {
          controller: "search",
          turbo_frame: "ticket_list",
          action: "input->search#schedule keydown.esc->search#clear"
        } do |form| %>
    <%# The filters are the list's other narrowing and must survive a search;
        without these, typing in the box would silently drop them. %>
    <%= form.hidden_field :state, value: @state_param, id: nil if @state_param %>
    <%= form.hidden_field :assignee, value: @assignee_filter, id: nil if @assignee_filter %>

    <%= form.search_field :q, value: @query, placeholder: "Search subject, message, address",
          autocomplete: "off",
          data: { search_target: "field", shortcuts_target: "search" },
          class: "flex-1 min-w-0 bg-transparent border-0 outline-none p-0 text-base
                  text-ink placeholder:text-faint" %>
    <span class="font-mono text-2xs text-faint"><%= @query.present? ? "esc to clear" : "/" %></span>
  <% end %>

  <%# Filters and rows share a frame so a filter click swaps both the list and
      the chips' own active state in one request. turbo-action="advance" keeps
      the address bar in step, so a filtered inbox stays linkable and the back
      button still works. %>
  <%= turbo_frame_tag "ticket_list", data: { turbo_action: "advance" } do %>
    <%= render "filters" %>

    <%# People, above the tickets and separate from them. A person match is a
        different kind of answer, not a better-ranked ticket — see
        _person_row.html.erb. Deliberately not narrowed by the state and
        assignee filters: a person is not open or waiting. %>
    <% if @customers.present? %>
      <div class="mt-8 text-2xs uppercase tracking-[0.09em] text-faint">People</div>
      <div class="relative pl-[30px] mt-3.5">
        <div class="absolute left-1 top-0 bottom-0 w-px bg-rule"></div>

        <% @customers.each do |customer| %>
          <%= render "tickets/person_row",
                customer: customer,
                counts: @customer_counts[customer.id] %>
        <% end %>
      </div>
    <% end %>

    <% if @tickets.any? %>
      <% if @customers.present? %>
        <div class="mt-8 text-2xs uppercase tracking-[0.09em] text-faint">Tickets</div>
      <% end %>

      <div class="relative pl-[30px] <%= @customers.present? ? "mt-3.5" : "mt-1.5" %>">
        <%# The vertical rule the row dots sit on. %>
        <div class="absolute left-1 top-0 bottom-0 w-px bg-rule"></div>

        <% @tickets.each do |ticket| %>
          <%= render "tickets/ticket_row",
                ticket: ticket,
                latest: @latest_messages[ticket.id],
                agents_by_id: @agents_by_id,
                compact: false %>
        <% end %>
      </div>

      <%# The cap is applied after collapsing matches to tickets, so this counts
          tickets — but a silent ceiling reads as "that is all there is". %>
      <% if searching? && @matches.size >= TicketsController::LIST_LIMIT %>
        <p class="mt-6 text-sm text-faint">
          Showing the first <%= TicketsController::LIST_LIMIT %> matches. Narrow the search to see fewer.
        </p>
      <% end %>
    <% else %>
      <p class="mt-10 text-sm text-soft">
        <% if searching? %>
          No tickets match “<%= @query %>”<%= " in this filter" if @state_filter || @assignee_filter %>.
          <%# The filter is the likeliest reason a search looks empty, and the
              least visible. Offering the wider search costs nothing and does
              not claim there is anything there. %>
          <% if @state_filter || @assignee_filter %>
            <%= link_to "Search all tickets", tickets_path(q: @query, state: "all"), class: "text-ink underline" %>.
          <% end %>
        <% elsif @query.present? %>
          Keep typing — search needs at least <%= Customer::MIN_SEARCH_LENGTH %> characters.
        <% else %>
          Nothing here.
          <% if @state_filter || @assignee_filter %>
            <%= link_to "Clear the filters", tickets_path(state: "all"), class: "text-ink underline" %> to see every ticket.
          <% end %>
        <% end %>
      </p>
    <% end %>
  <% end %>
</div>
