<%#
  State and assignee filters. Plain links, not a form: each is a GET that
  changes the query string, which keeps a filtered list linkable and the back
  button meaningful.

  Every link spells its state out — "all" included, via @state_param — because
  a URL with no filters at all now means "restore the remembered view" (see the
  controller). No chip may produce that URL by accident.

  Rendered inside the ticket_list turbo-frame along with the list itself, so
  clicking one swaps both the rows and the chips' own active state.
%>
<div class="flex flex-wrap gap-7 mt-[26px] pb-3.5 border-b border-rule text-sm">
  <div class="flex items-baseline gap-3.5">
    <span class="text-faint">State</span>

    <%= link_to "All", tickets_path(q: @query, state: "all", assignee: @assignee_filter),
          class: "hover:no-underline #{chip_class(@state_filter.nil?)}" %>

    <% TicketsHelper::STATE_FILTER_LABELS.each do |value, label| %>
      <%= link_to label, tickets_path(q: @query, state: value, assignee: @assignee_filter),
            class: "hover:no-underline #{chip_class(@state_filter == value)}" %>
    <% end %>
  </div>

  <div class="flex items-baseline gap-3.5">
    <span class="text-faint">Assignee</span>

    <%= link_to "Anyone", tickets_path(q: @query, state: @state_param),
          class: "hover:no-underline #{chip_class(@assignee_filter.nil?)}" %>

    <%= link_to "Me", tickets_path(q: @query, state: @state_param, assignee: "me"),
          class: "hover:no-underline #{chip_class(@assignee_filter == "me")}" %>

    <% @agents.each do |agent| %>
      <% next if agent.id == current_agent&.id %>
      <%= link_to agent.display_name.split(/\s+/).first,
            tickets_path(q: @query, state: @state_param, assignee: agent.id),
            class: "hover:no-underline #{chip_class(@assignee_filter == agent.id.to_s)}" %>
    <% end %>

    <%= link_to "Unassigned", tickets_path(q: @query, state: @state_param, assignee: "unassigned"),
          class: "hover:no-underline #{chip_class(@assignee_filter == "unassigned")}" %>
  </div>

  <%# The search shown as one more active narrowing, and removable like one.
      Without this a searched inbox is indistinguishable from a quiet one: you
      look away, come back to four tickets, and nothing on the screen explains
      why. The state filters have always had that problem solved by their own
      chips; search gets the same treatment rather than a different one. %>
  <% if @query.present? %>
    <div class="flex items-baseline gap-3.5">
      <span class="text-faint">Search</span>
      <span class="text-ink font-semibold">“<%= @query %>”</span>
      <%= link_to "Clear", tickets_path(state: @state_param, assignee: @assignee_filter),
            class: "text-soft hover:text-ink hover:no-underline" %>
    </div>
  <% end %>
</div>
