<%#
  The compose box. One form that writes either a reply or an internal note —
  the toggle flips a hidden field rather than swapping forms, so a half-typed
  draft survives changing your mind about who it's for.

  Templates land in the box for the agent to edit and are never auto-sent
  (docs/ui-contract.md). Each is pre-rendered server-side so {{customer.name}}
  and friends are already interpolated by the time they reach the button.

  Locals: ticket, templates
%>
<%# data-turbo-permanent: morph refreshes (a reply arriving while you type)
    must not touch this subtree, or the draft and the reply/note toggle state
    would be silently reset. Permanence keys on the id. %>
<section id="compose" class="mt-12 border-t border-rule-strong pt-[18px]"
         data-turbo-permanent
         data-controller="composer"
         data-composer-note-class="text-ink">

  <%= form_with url: ticket_messages_path(ticket), method: :post,
        data: { composer_target: "form" } do |form| %>

    <%= form.hidden_field :direction, value: "outbound",
          data: { composer_target: "direction" } %>

    <div class="flex items-baseline gap-2.5 text-sm text-soft">
      <span data-composer-target="modeLabel">Reply to</span>
      <span class="font-mono text-xs text-ink" data-composer-target="recipient">
        <%= ticket.customer.email %>
      </span>

      <button type="button"
              data-action="composer#toggleMode"
              data-composer-target="modeToggle"
              class="ml-auto cursor-pointer text-faint hover:text-ink">
        Internal note instead
      </button>
    </div>

    <%# Borderless on purpose: the rule above the box is the edge, and a second
        one around the field would be a box inside a box. %>
    <%= form.text_area :body, rows: 5,
          placeholder: "Write a reply…",
          data: { composer_target: "body" },
          class: "block w-full mt-3.5 bg-transparent text-ink leading-message border-0 outline-none resize-y p-0 placeholder:text-faint" %>

    <div class="flex items-center gap-6 mt-[18px] text-sm">
      <% if templates.any? %>
        <button type="button"
                data-action="composer#toggleTemplates"
                data-composer-target="templatesToggle"
                aria-expanded="false"
                class="cursor-pointer text-soft hover:text-ink">Templates</button>
      <% end %>

      <button type="submit"
              class="ml-auto flex items-center gap-2.5 cursor-pointer font-semibold text-ink hover:underline">
        <span class="w-[7px] h-[7px] rounded-full bg-accent"></span>
        <span data-composer-target="submitLabel">Send reply</span>
      </button>
    </div>

    <% if templates.any? %>
      <div data-composer-target="templates" hidden
           class="mt-4 border-t border-rule max-w-[520px]">
        <% templates.each do |template| %>
          <% rendered = template.render(customer: ticket.customer, agent: current_agent) %>
          <button type="button"
                  data-action="composer#useTemplate"
                  data-composer-body-param="<%= rendered[:body] %>"
                  class="flex w-full items-baseline gap-4 border-b border-rule py-[11px] cursor-pointer text-left text-sm hover:bg-hover">
            <span class="text-ink"><%= template.name %></span>
            <% if rendered[:subject].present? %>
              <span class="ml-auto text-xs text-faint truncate"><%= rendered[:subject] %></span>
            <% end %>
          </button>
        <% end %>
      </div>
    <% end %>
  <% end %>
</section>
