# Spool configuration. Copy to .env and fill in.
#
#   cp .env.example .env
#
# Everything Spool reads is here; there is no settings file and no admin
# screen. .env is gitignored — this file is the one that gets committed, so
# keep real secrets out of it.
#
# Compose reads .env twice over: once for its own ${...} interpolation (which
# is how SPOOL_HOST reaches Caddy) and once as the app containers' env_file.

# --- Secrets -----------------------------------------------------------------

# Signs sessions and cookies. Generate one and keep it: changing it logs
# everyone out. Anything long and random will do —
#
#   openssl rand -hex 64
#
# From a checkout of this repo, `bin/rails secret` produces the same thing.
# Don't reuse the value across environments, and don't commit it.
SECRET_KEY_BASE=

# --- The instance ------------------------------------------------------------

# Host authority for absolute URLs — a hostname, or "host:port". Never a URI:
# no scheme, no trailing slash. It is also the certificate hostname in
# compose.yml, and the host your OIDC redirect URI must use.
SPOOL_HOST=spool.example.com

# The support address. Shown in the header, and the From: on outbound mail.
SPOOL_MAILBOX=support@example.com

# Domain for generated Message-IDs. Defaults to SPOOL_HOST's domain; set it
# only when the two differ.
# SPOOL_MESSAGE_ID_DOMAIN=example.com

# The queue, reached by service name on the compose network.
TUBER_URL=tuber:11300

# --- Who can sign in ---------------------------------------------------------
#
# Two states are fatal at boot rather than warnings, because both fail in ways
# that are hard to diagnose from outside:
#
#   OIDC set with an empty allowlist  — every login is denied *after* a
#                                       successful round trip to the provider,
#                                       which reads like the user's fault.
#   No provider at all in production  — an unauthenticated helpdesk serves
#                                       every customer's correspondence.
#
# A half-set provider is not fatal but the UI returns 503 until it is complete.
# All three of the next values, or none.

# The provider's discovery document. Some examples:
#
#   Authentik   https://id.example.com/application/o/spool/.well-known/openid-configuration
#   Keycloak    https://id.example.com/realms/main/.well-known/openid-configuration
#   Google      https://accounts.google.com/.well-known/openid-configuration
#   Okta        https://example.okta.com/.well-known/openid-configuration
#   Entra ID    https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
OIDC_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration

# The client you registered with the provider. Its redirect URI — the one the
# provider must have on file — is:
#
#   https://<SPOOL_HOST>/auth/callback
#
# https, and the same host as SPOOL_HOST. A mismatch is reported by the
# provider rather than by Spool, which is why it is worth checking first.
OIDC_CLIENT_ID=spool
OIDC_CLIENT_SECRET=

# Optional. The name on the login button — "Sign in with Example ID".
# OIDC_PROVIDER_NAME=Example ID

# Optional. An issuer override, for providers whose discovery URL doesn't imply
# the issuer they actually assert.
# OIDC_ISSUER=https://id.example.com

# At least one of these must be non-empty once OIDC is configured, or Spool
# refuses to boot. Comma-separated. Domains match subdomains, and accept a
# leading "*.".
SPOOL_ALLOWED_DOMAINS=example.com
# SPOOL_ALLOWED_USERS=alice@example.com,bob@example.com

# --- Inbound mail ------------------------------------------------------------
#
# Spool reads mail over JMAP, not IMAP. Built against Fastmail, who wrote the
# protocol; any JMAP server works, since every URL is read from the session
# resource rather than hardcoded.
#
# Optional, and the only switch: with no token the poll job runs and returns
# immediately, so a checkout with no mail credentials is quiet.
#
# This is an **API token**, not an app password — app passwords are the
# IMAP/POP/SMTP credential and JMAP will not accept one. Create it at
# Settings → Privacy & Security → Manage API tokens, with exactly two scopes:
#
#   urn:ietf:params:jmap:core   (mandatory alongside any other scope)
#   urn:ietf:params:jmap:mail   — READ ONLY
#
# Read-only is deliberate and sufficient. Spool never writes to the mailbox: it
# reads the folder and remembers how far it got. Give it write access and it
# gains nothing, because a JMAP token is scoped to an account and not to a
# folder — anything that could file mail out of the support folder could also
# rewrite every other folder on the account. The poller logs a warning if the
# token it is given can write.
#
# Do NOT add urn:ietf:params:jmap:submission. Outbound mail goes through
# Mailgun (below), never through JMAP, so the scope is permanently unneeded —
# granting it is nothing but standing authority to send mail as your domain,
# sitting unused in a deployed environment.
#
# Read access is still account-wide, for the same lack of folder scoping. A
# dedicated Fastmail account for the support address is the fix, not a narrower
# scope.
# SPOOL_JMAP_TOKEN=

# The JMAP session resource. Only set this for a non-Fastmail server — the
# default is correct for Fastmail, including accounts pinned to a region, since
# the session response is what supplies the real (regional) API and download
# URLs.
# SPOOL_JMAP_SESSION_URL=https://api.fastmail.com/jmap/session

# Where support mail lands. Create the folder in Fastmail and add a rule filing
# mail for the support address into it. Nested paths are "/"-separated.
#
# Spool reads the folder and records how far it got, so the folder accumulates
# rather than draining — treat it as an archive, not a worklist. Nothing reads
# or writes the \Seen flag either, so opening the mailbox in a phone client
# cannot consume the queue.
#
# One consequence worth knowing: the high-water mark is a delivery timestamp, so
# an old message hand-dragged into this folder lands behind it and is never
# picked up. Forward such a message to the support address instead.
#
# Changing this value starts a fresh high-water mark, because the cursor is kept
# per folder. Everything already in the new folder is then read from the
# beginning, which message_id dedup makes harmless.
# SPOOL_JMAP_FOLDER=Spool

# Messages per poll. Not a protocol limit — it caps memory per run. A backlog
# simply takes several polls.
# SPOOL_JMAP_BATCH_SIZE=50

# --- Outbound mail -----------------------------------------------------------
#
# Replies are sent through one of two transports, picked by which env vars are
# set: SMTP when SMTP_ADDRESS is present (the common case — a local relay, or
# an inbox provider with SMTP creds like Fastmail), Mailgun otherwise. With
# neither configured nothing enqueues and nothing sends — replies compose fine
# and simply stay stored, marked "Queued · not yet delivered" in the thread.
# Once credentials exist, `bin/rails outbound:backfill` sends the accumulation.
#
# SPOOL_MAILBOX is shared by both transports — it's the From: header the
# customer sees, and what makes their reply land back in the folder the JMAP
# poller reads. It's required for either transport to be "configured".

# --- SMTP -------------------------------------------------------------------
#
# The simplest path: point at an SMTP server you already have (your inbox
# provider, a local relay). TLS is on by default — STARTTLS auto on 587,
# implicit TLS on 465 — and certificates are verified. SMTP_OPENSSL_VERIFY_MODE=none
# disables verification for a local relay with a self-signed cert; a boot
# warning surfaces it so it can't drift into a production deploy unnoticed.
# (Notably, this works where Mailgun's subdomain/DKIM setup is overkill —
# sending through Fastmail with the same creds the poller uses to read.)

# The SMTP server to relay through. Setting this (with SPOOL_MAILBOX) is what
# makes SMTP configured.
# SMTP_ADDRESS=smtp.fastmail.com

# Default 587 (STARTTLS auto). Use 465 for implicit TLS; the transport turns
# implicit TLS on automatically for that port.
# SMTP_PORT=587

# Omit both for no-auth (an open local relay). When set, SMTP_AUTHENTICATION
# defaults to plain.
# SMTP_USER_NAME=booko@booko.com.au
# SMTP_PASSWORD=

# The HELO/EHLO domain. Some providers require it match a verified domain.
# SMTP_DOMAIN=

# plain (default) | login | cram_md5 | xoauth2
# SMTP_AUTHENTICATION=plain

# Default true (opportunistic STARTTLS upgrade). Set to false only for a
# plaintext-only local relay.
# SMTP_ENABLE_STARTTLS_AUTO=true

# Force implicit TLS on a non-465 port, or leave unset to let the port decide.
# SMTP_ENABLE_TLS=false

# Default unset (certificates verified). Set to none for a self-signed local
# relay ONLY — outbound mail to customers is vulnerable to interception on
# the SMTP hop otherwise. peer | client_once | none
# SMTP_OPENSSL_VERIFY_MODE=peer

# --- Mailgun ----------------------------------------------------------------
#
# The alternative: Mailgun on a *subdomain* (mg.yourdomain.com, DNS records
# from the Mailgun dashboard) so SPF and MX for the apex stay with Fastmail
# untouched. Mailgun DKIM-signs and owns the envelope sender; the From: header
# stays SPOOL_MAILBOX. Reach for this when you want a provider handling
# deliverability (DKIM, bounce handling, suppression lists) rather than sending
# through your inbox provider. Used only when SMTP_ADDRESS is unset.

# A Mailgun sending API key — Mailgun dashboard → Send → Domain settings →
# Sending API keys. Scoped to sending; not the account-wide private key.
# MAILGUN_API_KEY=

# The Mailgun sending domain — the subdomain you verified with them.
# MAILGUN_DOMAIN=mg.example.com

# Only for accounts in Mailgun's EU region.
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# --- Errors ------------------------------------------------------------------
#
# Optional, and the only switch: unset means the Sentry SDK never initialises
# and every capture in the app is a no-op. Nothing else needs changing to turn
# reporting off.
#
# Spool speaks the Sentry protocol, so hosted Sentry works, but this was built
# against Splat (https://github.com/dkam/splat) — create a project there and use
# the "Copy External DSN" button on the project page. The shape is
#
#   https://<public-key>@<splat-host>/<project-slug>
#
# Splat also shows an *internal* DSN when it has an internal host configured:
# plain http to a Tailscale or LAN address. Prefer it when Spool can reach Splat
# without going out to the internet — one less TLS handshake per event, and
# reporting keeps working when public DNS doesn't.
# SENTRY_DSN=https://abc123@splat.example.com/spool

# Transaction sampling for the APM side, off by default. Errors are always sent
# in full and are not affected by this. 0.1 samples one request in ten; health
# checks are dropped whatever this says.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Tuning ------------------------------------------------------------------
#
# The defaults are right at this scale; uncomment if you have a reason.

# One Puma process is right for one host. Threads are also the SQLite writer
# pool size — see docs/architecture.md before raising either.
# WEB_CONCURRENCY=1
# RAILS_MAX_THREADS=5

# How many consumers each `bin/worker` container runs per tube.
# JOB_CONCURRENCY=1

# RAILS_LOG_LEVEL=info
