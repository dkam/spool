# Spool configuration. Copy to .env and fill in.
#
#   cp .env.example .env
#
# Everything Spool reads is here; there is no settings file and no admin
# screen. .env is gitignored — this file is the one that gets committed, so
# keep real secrets out of it.
#
# Compose reads .env twice over: once for its own ${...} interpolation (which
# is how SPOOL_HOST reaches Caddy) and once as the app containers' env_file.

# --- Secrets -----------------------------------------------------------------

# Signs sessions and cookies. Generate one and keep it: changing it logs
# everyone out. Anything long and random will do —
#
#   openssl rand -hex 64
#
# From a checkout of this repo, `bin/rails secret` produces the same thing.
# Don't reuse the value across environments, and don't commit it.
SECRET_KEY_BASE=

# --- The instance ------------------------------------------------------------

# Host authority for absolute URLs — a hostname, or "host:port". Never a URI:
# no scheme, no trailing slash. It is also the certificate hostname in
# compose.yml, and the host your OIDC redirect URI must use.
SPOOL_HOST=spool.example.com

# The support address. Shown in the header, and the From: on outbound mail.
SPOOL_MAILBOX=support@example.com

# Domain for generated Message-IDs. Defaults to SPOOL_HOST's domain; set it
# only when the two differ.
# SPOOL_MESSAGE_ID_DOMAIN=example.com

# The queue, reached by service name on the compose network.
TUBER_URL=tuber:11300

# --- Who can sign in ---------------------------------------------------------
#
# Two states are fatal at boot rather than warnings, because both fail in ways
# that are hard to diagnose from outside:
#
#   OIDC set with an empty allowlist  — every login is denied *after* a
#                                       successful round trip to the provider,
#                                       which reads like the user's fault.
#   No provider at all in production  — an unauthenticated helpdesk serves
#                                       every customer's correspondence.
#
# A half-set provider is not fatal but the UI returns 503 until it is complete.
# All three of the next values, or none.

# The provider's discovery document. Some examples:
#
#   Authentik   https://id.example.com/application/o/spool/.well-known/openid-configuration
#   Keycloak    https://id.example.com/realms/main/.well-known/openid-configuration
#   Google      https://accounts.google.com/.well-known/openid-configuration
#   Okta        https://example.okta.com/.well-known/openid-configuration
#   Entra ID    https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
OIDC_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration

# The client you registered with the provider. Its redirect URI — the one the
# provider must have on file — is:
#
#   https://<SPOOL_HOST>/auth/callback
#
# https, and the same host as SPOOL_HOST. A mismatch is reported by the
# provider rather than by Spool, which is why it is worth checking first.
OIDC_CLIENT_ID=spool
OIDC_CLIENT_SECRET=

# Optional. The name on the login button — "Sign in with Example ID".
# OIDC_PROVIDER_NAME=Example ID

# Optional. An issuer override, for providers whose discovery URL doesn't imply
# the issuer they actually assert.
# OIDC_ISSUER=https://id.example.com

# At least one of these must be non-empty once OIDC is configured, or Spool
# refuses to boot. Comma-separated. Domains match subdomains, and accept a
# leading "*.".
SPOOL_ALLOWED_DOMAINS=example.com
# SPOOL_ALLOWED_USERS=alice@example.com,bob@example.com

# --- Errors ------------------------------------------------------------------
#
# Optional, and the only switch: unset means the Sentry SDK never initialises
# and every capture in the app is a no-op. Nothing else needs changing to turn
# reporting off.
#
# Spool speaks the Sentry protocol, so hosted Sentry works, but this was built
# against Splat (https://github.com/dkam/splat) — create a project there and use
# the "Copy External DSN" button on the project page. The shape is
#
#   https://<public-key>@<splat-host>/<project-slug>
#
# Splat also shows an *internal* DSN when it has an internal host configured:
# plain http to a Tailscale or LAN address. Prefer it when Spool can reach Splat
# without going out to the internet — one less TLS handshake per event, and
# reporting keeps working when public DNS doesn't.
# SENTRY_DSN=https://abc123@splat.example.com/spool

# Transaction sampling for the APM side, off by default. Errors are always sent
# in full and are not affected by this. 0.1 samples one request in ten; health
# checks are dropped whatever this says.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Tuning ------------------------------------------------------------------
#
# The defaults are right at this scale; uncomment if you have a reason.

# One Puma process is right for one host. Threads are also the SQLite writer
# pool size — see docs/architecture.md before raising either.
# WEB_CONCURRENCY=1
# RAILS_MAX_THREADS=5

# How many consumers each `bin/worker` container runs per tube.
# JOB_CONCURRENCY=1

# RAILS_LOG_LEVEL=info
