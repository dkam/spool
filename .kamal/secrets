# Secrets referenced from config/deploy.yml under registry/password, env/secret,
# builder/secrets and accessories/*/env/secret. Every value here is pulled from
# ENV, a file, or a password manager. DO NOT ENTER RAW CREDENTIALS HERE — this
# file is committed.

# The GitHub Packages token that can push and pull ghcr.io/dkam/spool.
# A classic PAT with write:packages, or the gh CLI's own token for a manual deploy.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails credentials. config/master.key is gitignored; never commit it.
RAILS_MASTER_KEY=$(cat config/master.key)

# The OIDC client secret issued by the provider. Without it the app boots in
# :misconfigured state and refuses to serve — see docs/auth.md.
OIDC_CLIENT_SECRET=$OIDC_CLIENT_SECRET

