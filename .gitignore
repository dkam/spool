# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files — except the template, which is the one place
# every setting is written down and has to be committed to be useful.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# --- Spool ------------------------------------------------------------------

# Per-environment credential keys. The rule above is /config/*.key, which does
# not reach into the subdirectory, so a config/credentials/production.key would
# otherwise be committed alongside the file it decrypts.
/config/credentials/*.key

# Bundler's vendored gems, for anyone who runs `bundle config path vendor/bundle`.
/vendor/bundle

# macOS writes one of these into every directory it opens. The header above is
# right that OS files belong in a global ignore, and this is a deliberate
# exception to it: the cost of being wrong once in a shared repo is higher than
# the cost of the line.
.DS_Store
